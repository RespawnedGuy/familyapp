<?xml version="1.0" encoding="utf-8"?>
<!--
  UI texts of the app (quality plan P1-7). German is the default language (folder values/).
  A translation goes into values-<language>/strings.xml with the same names.
  Names: <screen>_<what>, shared words start with common_. Use plurals for counted texts.
  Placeholders: %1$s (text), %1$d (number). Kept in sync with the code by the quality gate
  (tools/quality-check, UiStringsTest): texts in already converted files must come from here.
-->
